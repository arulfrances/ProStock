# Indstocks API
IND_API_KEY=""
IND_ACCESS_TOKEN=""

# Auto-refresh the Indstocks instrument master (symbol -> security_id) from the web
INDSTOCKS_AUTO_REFRESH_ENABLED="true"
INDSTOCKS_REFRESH_HOURS="24"
INDSTOCKS_REFRESH_SEGMENTS="equity,fno,index"

# Telegram alerts (Cloudflare Pages secrets)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_API_KEY=""

# Public HTTPS URL of the FastAPI market service.
MARKET_API_BASE=""

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/prostock"

# Realtime signal engine
MIN_CONFIDENCE="0.80"
REALTIME_POLL_SECONDS="20"
REALTIME_SYMBOLS="NIFTY 50,BANKNIFTY,SENSEX"
NEWS_FEED_URLS="https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.moneycontrol.com/rss/marketreports.xml"
REALTIME_ENGINE_ENABLED="true"

# Early "heads up" Telegram alert sent ahead of the confirmed signal
EARLY_WARNING_ENABLED="true"
EARLY_WARNING_LEAD_SECONDS="300"
